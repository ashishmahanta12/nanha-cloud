# Cloudflare Pages environment variables (Dashboard → Settings → Environment variables)
# Used by functions/_middleware.js to proxy /api and /socket.io to Render.

NANHA_API_ORIGIN=https://YOUR-RENDER-SERVICE.onrender.com

# Optional: only if you bypass the Pages proxy and call Render directly from the browser
# (requires CORS_ORIGINS + COOKIE_SAMESITE=none on the backend). Prefer the proxy.
# NANHA_API_BASE=
